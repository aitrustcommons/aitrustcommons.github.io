---
// One page per post, at the same address as on the old site.
// The post body renders unchanged. Its leading title, series line and hero
// image are lifted into this header by remark-post-header.mjs.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../../../../layouts/Base.astro';
import { allPosts, postPath, displayDate, isoDay, readMinutes, extrasFor } from '../../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((entry) => {
    const [, , year, month, day, slug] = postPath(entry.post).split('/');
    return { params: { year, month, day, slug }, props: { entry, all: posts } };
  });
}

const { entry, all } = Astro.props;
const { post, title, heroFile, rendered } = entry;
const { Content } = rendered;
const fm = rendered.remarkPluginFrontmatter as { seriesLine?: string };
const extra = extrasFor(post);
const heroAlt = extra?.heroAlt ?? entry.heroAlt;
const next = extra?.next ? all.find((e) => e.post.data.slug === extra.next) : undefined;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', { eager: true });
const hero = heroFile ? images[`/src/assets/images/${heroFile}`]?.default : undefined;
const kicker = fm.seriesLine ? `${fm.seriesLine}${extra?.part ? ` · PART ${extra.part}` : ''}` : post.data.categories.join(', ').toUpperCase();
const usesMermaid = (post.body ?? '').includes('```mermaid');
---
<Base
  title={title}
  description={post.data.description}
  image={post.data.image ? `/${post.data.image}` : undefined}
  post={{ published: isoDay(post), categories: post.data.categories }}
  current="blog"
  mermaid={usesMermaid}
>
  <article>
    <header class="post-head">
      <div class="kicker">
        {fm.seriesLine && extra?.part ? <a href="/blog/category/from-instinct-to-intent-series/" style="color: inherit; text-decoration: none">{kicker}</a> : kicker}
      </div>
      <h1>{title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="meta">
        <span class="author">Nikhil Singhal</span>
        <time datetime={isoDay(post)}>{displayDate(post)}</time>
        <span>{readMinutes(post.body ?? '')} min read</span>
        {extra?.medium && <a href={extra.medium}>Also on Medium</a>}
      </div>
    </header>
    {hero && (
      <figure class="post-hero" style="margin: 0 auto">
        <Image src={hero} alt={heroAlt} widths={[640, 1008, 1600]} sizes="(max-width: 1008px) 100vw, 1008px" loading="eager" />
      </figure>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
  <nav class="series-nav" aria-label="More posts">
    {next && (
      <a class="next-card" href={postPath(next.post)}>
        <span class="kicker">NEXT IN THE SERIES</span>
        <span class="title">{next.title}</span>
        <span class="meta"><span>{displayDate(next.post)}</span><span>{readMinutes(next.post.body ?? '')} min read</span></span>
      </a>
    )}
    <a href="/blog/" style="align-self: flex-start; font-size: 15px">All posts</a>
  </nav>
</Base>
