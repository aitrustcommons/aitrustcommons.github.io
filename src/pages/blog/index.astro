---
// The blog keeps its title, "From Instinct to Intent™", word for word.
// Trademark application 99690685 cites "the journal titled with the mark".
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { allPosts } from '../../lib/posts';
const posts = await allPosts();
---
<Base
  title="Blog: From Instinct to Intent"
  description="Articles on the structural gap between human intent and machine execution. The From Instinct to Intent series by Nikhil Singhal."
  current="blog"
>
  <div class="wrap">
    <div class="list-head">
      <h1 class="page-title">From Instinct to Intent™</h1>
      <p class="lede">Articles exploring the structural gap between human intent and machine execution. What happens when you stop calling it "artificial" and start building with intelligence.</p>
      <p class="lede">Also published on <a href="https://nikhilsinghal-ai-trust-commons.medium.com/">Medium</a> and Zenodo. The five articles of the series are also on <a href="/blog/category/from-instinct-to-intent-series/">their own page</a>.</p>
    </div>
    <div class="post-list">
      {posts.map(({ post, title }) => <PostRow post={post} title={title} />)}
    </div>
  </div>
</Base>
