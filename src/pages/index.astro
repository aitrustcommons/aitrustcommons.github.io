---
// Home: "AI governance in practice". Mockups SiteB (top), SiteBottom
// (below step 9) and SitePhone. Build spec section 6.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import StepSection from '../components/StepSection.astro';
import PieceSection from '../components/PieceSection.astro';
import OutcomeIcon from '../components/OutcomeIcon.astro';
import picture from '../data/picture.json';
import pieces from '../data/pieces.json';
import home from '../data/home.json';
import site from '../data/site.json';
import { allPosts, postPath, displayDate, isoDay, readMinutes } from '../lib/posts';

// The production build on GitHub refuses to publish placeholder text.
const missingPieces = pieces.pieces.filter((p) => p.text.filter((t) => t.trim()).length === 0).map((p) => p.name);
if (import.meta.env.PROD && process.env.REQUIRE_PIECE_TEXT === '1') {
  if (missingPieces.length) throw new Error(`Home page: no text yet for ${missingPieces.join(', ')}. Add it to src/data/pieces.json.`);
  if (!home.reviewed) throw new Error('Home page: the overview is waiting for Nikhil\'s review. Set reviewed to true in src/data/home.json.');
}

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/picture/*.png', { eager: true });
const img = (name: string) => files[`/src/assets/picture/${name}.png`].default;
const stepImages = (n: number, head: string) =>
  (n === 6 ? ['step6', 'step6b'] : [`step${n}`]).map((name) => ({
    src: img(name),
    alt: `Close-up of step ${n} on the picture`,
    full: img(name).src,
  }));

const lineFor = (p: { name: string; product: string }) =>
  picture.pieces.find((x) => x.name === `${p.name} · ${p.product}`)?.line ?? '';

// Read time for the page, with the same rule as the posts.
const words = [
  ...home.intro.sections.flatMap((x) => x.paragraphs),
  ...home.overview,
  ...picture.gate_lines,
  ...picture.outcomes.map((o) => `${o.word} ${o.line}`),
  picture.record.body,
  picture.loop.body,
  ...picture.steps.flatMap((s) => s.parts.flatMap((p: any) => [p.head, p.body, p.crossing, ...(p.text ?? []), ...(p.fields ?? []).map((f: any) => `${f.label} ${f.value}`), p.recorded])),
  ...pieces.pieces.flatMap((p) => [lineFor(p), ...p.text]),
].filter(Boolean).join(' ');
const minutes = readMinutes(words);

const latest = (await allPosts()).slice(0, 3);

// The home page as an article by Nikhil Singhal, for search and AI readers.
const SITE = site.url;
const homeLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${SITE}/#article`,
  url: `${SITE}/`,
  mainEntityOfPage: `${SITE}/`,
  headline: picture.title,
  description: home.meta_description,
  image: `${SITE}/picture/ai-governance-in-practice.png`,
  datePublished: `${home.published}T00:00:00Z`,
  dateModified: `${home.updated}T00:00:00Z`,
  author: { '@type': 'Person', '@id': 'https://nikhilsinghal.com/#person', name: 'Nikhil Singhal', url: 'https://nikhilsinghal.com' },
  publisher: { '@id': `${SITE}/#organization` },
  isPartOf: { '@id': `${SITE}/#website` },
  about: [{ '@type': 'Thing', name: 'AI governance' }, { '@type': 'Thing', name: 'AI agents' }],
  inLanguage: 'en',
  license: 'https://creativecommons.org/licenses/by/4.0/',
};
---
<Base title={`${picture.title}: how to govern AI agents`} description={home.meta_description} current="home" ld={homeLd} markdownAlt="/ai-governance-in-practice.md">
  <div class="wrap">
    <section class="home-top" aria-labelledby="page-title">
      <h1 id="page-title" class="page-title">{picture.title}</h1>
      <p class="lede">{site.description}</p>
      <div class="meta">
        <a class="author" href="/about/">Nikhil Singhal</a>
        <span>Version {home.version.number}</span>
        <span>{home.version.label}</span>
        <span>{minutes} min read</span>
        <a href="/ai-governance-in-practice.pdf">Poster (PDF)</a>
        <a href="/ai-governance-in-practice.md">Plain text</a>
      </div>
    </section>

    <section id="why" class="intro" aria-labelledby="why-title">
      <h2 id="why-title">{home.intro.title}</h2>
      {home.intro.sections.map((sec) => (
        <div class="intro-part">
          <h3>{sec.heading}</h3>
          {sec.paragraphs.map((t) => <p>{t}</p>)}
        </div>
      ))}
    </section>

    <figure class="overview">
      <a href="/picture/">
        <Image src={img('overview')} alt="The AI governance in practice picture. It follows a contract from the experts' policies to both signatures and back to the experts." widths={[720, 1200, 2400]} sizes="(max-width: 1200px) 100vw, 1136px" loading="eager" />
      </a>
      <figcaption><a href="/picture/">Open the full picture</a></figcaption>
    </figure>

    <div class="doc">
      <nav class="contents" aria-label="Contents">
        <p class="kicker">CONTENTS</p>
        <a href="#why">Why AI governance</a>
        <a href="#overview">Overview</a>
        {picture.steps.map((s) => (
          <a href={`#step${s.number}`} class="contents-step">
            <span class={`contents-num tone-${s.color}`}>{s.number}</span>
            <span>{home.contents[String(s.number) as keyof typeof home.contents]}</span>
          </a>
        ))}
        <a href="#pieces">The five pieces</a>
        <a href="#versions">Versions</a>
      </nav>

      <nav class="step-dots" aria-label="Steps">
        <p class="kicker">THE NINE STEPS</p>
        <div class="step-dots-row">
          {picture.steps.map((s) => (
            <a href={`#step${s.number}`} class={`step-dot tone-${s.color}`} aria-label={`Step ${s.number}: ${home.contents[String(s.number) as keyof typeof home.contents]}`}>{s.number}</a>
          ))}
        </div>
      </nav>

      <div class="doc-main">
        <section id="overview" class="doc-section">
          <h2>Overview</h2>
          {home.overview.map((p) => <p>{p}</p>)}
          <h3 class="key-title">{home.key_title}</h3>
          <ul class="key">
            {picture.gate_lines.map((g) => <li>{g}</li>)}
          </ul>
          <ul class="key key-outcomes">
            {picture.outcomes.map((o) => (
              <li><OutcomeIcon outcome={o.outcome as any} size={18} /><span><b class={`gate-word gate-${o.outcome}-word`}>{o.word}:</b> {o.line}</span></li>
            ))}
          </ul>
          <p class="key-extra"><b class="gate-label">{picture.record.head}:</b> {picture.record.body}</p>
          <p class="key-extra"><b>{picture.loop.head}:</b> {picture.loop.body}</p>
        </section>

        <section class="doc-section steps" aria-labelledby="steps-title">
          <h2 id="steps-title" class="visually-hidden">The nine steps</h2>
          {picture.steps.map((step) => {
            const lead = step.parts.find((p: any) => p.lead) as any;
            return <StepSection step={step} images={stepImages(step.number, lead.head)} />;
          })}
        </section>

        <section id="pieces" class="doc-section">
          <h2>The five pieces</h2>
          <p>{home.govern_line}</p>
          <div class="pieces">
            {pieces.pieces.map((p) => <PieceSection piece={p} line={lineFor(p)} />)}
          </div>
        </section>

        <section id="versions" class="doc-section">
          <h2>Versions</h2>
          <ul class="versions">
            <li>Version {home.version.number} · {home.version.label} · First published.</li>
          </ul>
          <p><a href="/ai-governance-in-practice.pdf">Poster (PDF)</a></p>
        </section>
      </div>
    </div>
  </div>

  <section class="latest" aria-labelledby="latest-title">
    <div class="wrap">
      <h2 id="latest-title">Latest writing</h2>
      <div class="latest-grid">
        {latest.map(({ post, title }) => (
          <article>
            <time datetime={isoDay(post)}>{displayDate(post)}</time>
            <h3><a href={postPath(post)}>{title}</a></h3>
          </article>
        ))}
      </div>
      <p class="latest-links"><a href="/blog/">All posts</a><a href="/about/">About</a></p>
    </div>
  </section>
</Base>
