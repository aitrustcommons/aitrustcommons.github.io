---
// How the HIP Charter Was Made. Moved here from hipcharter.com in Nov 2026 (#625).
// The words live in src/content/hip/story.md; old section names are kept so shared links still land.
import Base from '../../../layouts/Base.astro';
import HipNav from '../../../components/HipNav.astro';
import { Content, frontmatter } from '../../../content/hip/story.md';

const SITE = 'https://aitrustcommons.org';
const CHARTER_ID = `${SITE}/hip-charter/#charter`;
const author = { '@type': 'Person', '@id': 'https://nikhilsinghal.com/#person', name: 'Nikhil Singhal', url: 'https://nikhilsinghal.com' };
const description = 'Twelve steps to name the HIP Charter and eight diagram versions in one day. A person and an AI working as partners, with the person steering.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${SITE}/hip-charter/story/#article`,
  url: `${SITE}/hip-charter/story/`,
  mainEntityOfPage: `${SITE}/hip-charter/story/`,
  headline: frontmatter.title,
  description,
  datePublished: '2026-03-17T00:00:00Z',
  dateModified: '2026-11-25T00:00:00Z',
  author,
  publisher: { '@id': `${SITE}/#organization` },
  isPartOf: { '@id': `${SITE}/#website` },
  image: `${SITE}/hip-charter/images/hip-charter-combination-lattice-full-poster.png`,
  about: { '@type': 'CreativeWork', '@id': CHARTER_ID, name: 'The Human Intelligence Partnership Charter', url: `${SITE}/hip-charter/` },
  inLanguage: 'en',
  license: 'https://creativecommons.org/licenses/by/4.0/',
};
---
<Base title={frontmatter.title} description={description} published="2026-03-17" current="hip" ld={ld}>
  <div class="page">
    <span id="how-the-hip-charter-was-made"></span>
    <HipNav current="story" />
    <h1 class="page-title">{frontmatter.title}</h1>
    <div class="meta">
      <a class="author" href="/about/">Nikhil Singhal</a>
      <span>Published March 17, 2026</span>
      <span>Updated November 2026</span>
    </div>
    <div class="prose">
      <Content />
    </div>
  </div>
</Base>
