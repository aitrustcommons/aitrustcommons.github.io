---
// One of the nine steps. The words are the poster's, word for word, from
// picture.json. The lead card gives the label at the top. Every part, the
// lead sentence included, then follows in the poster's order.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import GateBox from './GateBox.astro';

interface Props { step: any; images: { src: ImageMetadata; alt: string; full: string }[] }
const { step, images } = Astro.props;
const lead = step.parts.find((p: any) => p.lead);
---
<section id={`step${step.number}`} class={`step tone-${step.color}`} aria-labelledby={`step${step.number}-label`}>
  <h3 id={`step${step.number}-label`} class="step-label">
    <span class="step-num" aria-hidden="true">{step.number}</span>
    <span class="visually-hidden">Step {step.number}: </span>
    <span>{lead.head}</span>
  </h3>
  {step.parts.map((part: any) => {
    if (part.lead) return <p class="step-lead">{part.body}</p>;
    if (part.kind === 'gate') return <GateBox gate={part} />;
    if (part.kind === 'note') return <p class="step-note">{part.text}</p>;
    return (
      <div class={`step-card step-card-${part.kind}`}>
        <p><b class="step-card-head">{part.head}</b></p>
        <p>{part.body}</p>
      </div>
    );
  })}
  {images.map((img) => (
    <figure class="closeup" style={`max-width: ${Math.round(img.src.width / 2)}px`}>
      <Image src={img.src} alt={img.alt} widths={[480, 720, 1040]} sizes="(max-width: 760px) 100vw, 696px" />
      <figcaption><a href={img.full}>Enlarge</a></figcaption>
    </figure>
  ))}
</section>
